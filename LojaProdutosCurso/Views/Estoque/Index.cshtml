@using LojaProdutosCurso.Models
@model List<RegistroProdutoModel>

@{
    ViewData["Title"] = "Relatório de Vendas";
    var totalVendas = Model?.Sum(x => x.Total) ?? 0;
}

<div class="container py-5">
    <!-- Header e Resumo -->
    <div class="row g-4 mb-5 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Registro de Vendas
            </h2>
            <p class="text-muted mb-0">Acompanhe o desempenho e histórico de vendas da loja.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <div class="d-flex flex-column flex-md-row gap-3 justify-content-md-end">
                <div class="bg-white p-3 rounded-4 shadow-sm border-start border-primary border-4 d-inline-block text-start">
                    <small class="text-muted text-uppercase fw-bold smaller d-block mb-1">Faturamento Total</small>
                    <span class="h3 fw-bold text-success mb-0">@totalVendas.ToString("C")</span>
                </div>
                
                @if (Model != null && Model.Any())
                {
                    <form asp-controller="Estoque" asp-action="GerarRelatorio" class="d-flex align-items-center">
                        <button type="submit" class="btn btn-dark btn-lg rounded-pill px-4 shadow-sm h-100">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Gerar Relatório
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Tabela de Vendas -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="registros">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="border-0 px-3">Produto (ID)</th>
                            <th class="border-0">Categoria</th>
                            <th class="border-0 text-center">Data da Venda</th>
                            <th class="border-0 text-end px-3">Valor Total</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var registro in Model)
                            {
                                <tr>
                                    <td class="px-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light p-2 rounded-3 me-3">
                                                <i class="bi bi-hash text-primary fw-bold"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@registro.ProdutoId</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-medium px-3 py-2 rounded-pill">
                                            @registro.CategoriaNome
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-dark">@registro.DataCompra.ToString("dd/MM/yyyy")</span>
                                        <small class="text-muted d-block smaller">@registro.DataCompra.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-end px-3">
                                        <span class="fw-bold text-success fs-5">@registro.Total.ToString("C")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted opacity-50">
                                        <i class="bi bi-clipboard-x display-1 d-block mb-3"></i>
                                        <p class="fs-5">Nenhuma venda registrada até o momento.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>