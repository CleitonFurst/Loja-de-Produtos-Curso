@using LojaProdutosCurso.DTO.Usuario
@model CriarUsuarioDTO

@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Usuario" asp-action="Index">Usuários</a></li>
                    <li class="breadcrumb-item active">Cadastrar</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-dark p-4 border-0">
                    <h3 class="fw-bold mb-0"><i class="bi bi-person-plus-fill me-2"></i>Novo Usuário</h3>
                    <p class="text-dark opacity-75 small mb-0">Crie uma nova conta de acesso preenchendo os dados abaixo.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Cadastrar" asp-controller="Usuario" method="post">
                        
                        <h6 class="text-primary fw-bold text-uppercase small mb-4 pb-2 border-bottom">Informações Pessoais</h6>
                        
                        <div class="row g-4 mb-5">
                            <div class="col-md-7">
                                <label class="form-label fw-bold text-dark small text-uppercase">Nome Completo</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" asp-for="Nome" placeholder="Ex: João da Silva" />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-dark small text-uppercase">Cargo / Função</label>
                                <select class="form-select form-select-lg bg-light border-2 shadow-none" asp-for="Cargo">
                                    <option value="Cliente">Cliente</option>
                                    <option value="Administrador">Administrador</option>                
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold text-dark small text-uppercase">E-mail</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-2 border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control bg-light border-2 border-start-0 shadow-none" asp-for="Email" placeholder="joao@exemplo.com"/>
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold text-uppercase small mb-4 pb-2 border-bottom">Endereço e Localização</h6>

                        <div class="row g-4 mb-5">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">CEP</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" id="input-cep" asp-for="CEP" maxlength="9" placeholder="00000-000" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-dark small text-uppercase">Cidade</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" id="input-cidade" asp-for="Cidade" placeholder="Nome da cidade" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold text-dark small text-uppercase">Estado</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none text-center" id="input-estado" asp-for="Estado" placeholder="UF" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-dark small text-uppercase">Logradouro / Rua</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" id="input-logradouro" asp-for="Logradouro" placeholder="Ex: Av. Paulista" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">Número</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" asp-for="Numero" placeholder="Ex: 123" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small text-uppercase">Bairro</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" id="input-bairro" asp-for="Bairro" placeholder="Nome do bairro" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small text-uppercase">Complemento</label>
                                <input type="text" class="form-control form-control-lg bg-light border-2 shadow-none" id="input-complemento" asp-for="Complemento" placeholder="Apto, Sala, Bloco..." />
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold text-uppercase small mb-4 pb-2 border-bottom">Segurança</h6>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small text-uppercase">Senha de Acesso</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-2 border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                    <input type="password" class="form-control bg-light border-2 border-start-0 shadow-none" asp-for="Senha" placeholder="••••••••"/>
                                </div>
                                <span asp-validation-for="Senha" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small text-uppercase">Confirmar Senha</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-2 border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                                    <input type="password" class="form-control bg-light border-2 border-start-0 shadow-none" asp-for="ConfirmarSenha" placeholder="••••••••"/>
                                </div>
                                <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-md-row gap-3 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow flex-grow-1 fw-bold">
                                <i class="bi bi-check-circle me-2"></i>Confirmar Cadastro
                            </button>
                            <a asp-controller="Usuario" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-5">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var inputCep = document.querySelector('#input-cep');
        var inputLogradouro = document.querySelector('#input-logradouro');
        var inputBairro = document.querySelector('#input-bairro');
        var inputEstado = document.querySelector('#input-estado');
        var inputCidade = document.querySelector('#input-cidade');
        var inputComplemento = document.querySelector('#input-complemento');

        function formatCep(value) {
            var digits = (value || '').replace(/\D/g, '').slice(0, 8);
            if (digits.length > 5) {
                return digits.slice(0, 5) + '-' + digits.slice(5);
            }
            return digits;
        }

        if (inputCep) {
            inputCep.addEventListener('input', function (e) {
                e.target.value = formatCep(e.target.value);
            });

            inputCep.addEventListener('blur', async function (e) {
                var valueDigits = (e.target.value || '').replace(/\D/g, '');
                if (valueDigits.length !== 8) return;

                const url = `https://viacep.com.br/ws/${valueDigits}/json/`;
                try {
                    inputCep.classList.add('is-loading');
                    const resposta = await fetch(url);
                    const dados = await resposta.json();
                    
                    if (!dados.erro) {
                        if (inputLogradouro) inputLogradouro.value = dados.logradouro || '';
                        if (inputBairro) inputBairro.value = dados.bairro || '';
                        if (inputEstado) inputEstado.value = dados.uf || '';
                        if (inputCidade) inputCidade.value = dados.localidade || '';
                        if (inputComplemento && !inputComplemento.value) inputComplemento.value = dados.complemento || '';
                    }
                } catch (err) {
                    console.error('Erro ao buscar CEP:', err);
                } finally {
                    inputCep.classList.remove('is-loading');
                }
            });
        }
    });
</script>
