@using LojaProdutosCurso.DTO.Produto
@model CriarProdutoDTO

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Produtos</a></li>
                    <li class="breadcrumb-item active">Cadastrar</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <h3 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Novo Produto</h3>
                    <p class="text-light small opacity-75 mb-0">Preencha as informações abaixo para adicionar um produto ao estoque.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    @if (TempData["MensagemErro"] != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
                        </div>
                    }

                    <form asp-action="Cadastrar" asp-controller="Produto" method="post" enctype="multipart/form-data">
                        <div class="row g-4">
                            <!-- Upload de Foto -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-dark small text-uppercase">Foto do Produto</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-image text-muted"></i></span>
                                    <input class="form-control border-start-0 ps-0 shadow-none" type="file" name="foto" asp-for="Foto"/>
                                </div>
                                <span asp-validation-for="Foto" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Nome -->
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-dark small text-uppercase">Nome do Produto</label>
                                <input class="form-control form-control-lg shadow-none border-2 bg-light focus-ring" type="text" asp-for="Nome" placeholder="Ex: Teclado Mecânico RGB" />
                                <span asp-validation-for="Nome" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Marca -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">Marca</label>
                                <input class="form-control form-control-lg shadow-none border-2 bg-light" type="text" asp-for="Marca" placeholder="Ex: Logitech" />
                                <span asp-validation-for="Marca" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Valor -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">Preço (R$)</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-2 border-end-0">R$</span>
                                    <input class="form-control border-2 border-start-0 shadow-none bg-light" type="number" min="0" step="any" asp-for="Valor" placeholder="0,00"/>
                                </div>
                                <span asp-validation-for="Valor" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Quantidade -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">Estoque Inicial</label>
                                <input class="form-control form-control-lg shadow-none border-2 bg-light" type="number" min="0" asp-for="QuantidadeEstoque" placeholder="0"/>
                                <span asp-validation-for="QuantidadeEstoque" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Categoria -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">Categoria</label>
                                <select class="form-select form-select-lg shadow-none border-2 bg-light"
                                        asp-items="@(new SelectList(ViewBag.Categorias,"Id","Nome"))"
                                        asp-for="CategoriaModelId">
                                    <option value="">Selecione...</option>
                                </select>
                                <span asp-validation-for="CategoriaModelId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-12 mt-5">
                                <div class="d-flex flex-column flex-md-row gap-3">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 flex-grow-1 shadow">
                                        <i class="bi bi-check-circle me-2"></i>Finalizar Cadastro
                                    </button>
                                    <a class="btn btn-outline-secondary btn-lg rounded-pill px-5" asp-action="Index">
                                        Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>